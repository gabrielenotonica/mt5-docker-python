# Copy this to .env and edit it. Never commit .env.
#
# CUSTOM_USER and PASSWORD are yours to invent. They become the login prompt on
# http://localhost:3000, which guards the container's desktop — nothing checks
# them against anything, so whatever you put here is what you type there.
#
# They are NOT your broker credentials. Those you type into MetaTrader itself,
# over that desktop, once; they live in ./config and never appear in this file.
#
# The values below work as-is on a laptop, where the port is bound to loopback.
# Change them before the container is reachable by anything else.
PUID=1000
PGID=1000
TZ=Europe/Rome
CUSTOM_USER=trader
PASSWORD=changeme
